		<lsLogo0Y>0 + 0.035 + (${lsDy} * 0)</lsLogo0Y>
		<lsLogo1X>0 + 0.025 + (${lsDx} * 1)</lsLogo1X>
		<lsLogo1Y>0 + 0.035 + (${lsDy} * 0)</lsLogo1Y>
		<lsLogo2X>0 + 0.025 + (0 - ${lsDx} * 1)</lsLogo2X>
		<lsLogo2Y>0 + 0.035 + (${lsDy} * 0)</lsLogo2Y>
		<lsLogo3X>0 + 0.025 + (${lsDx} * 0)</lsLogo3X>
		<lsLogo3Y>0 + 0.035 + (${lsDy} * 1)</lsLogo3Y>
		<lsLogo4X>0 + 0.025 + (${lsDx} * 0)</lsLogo4X>
