<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Geometry of the icon views (system + game). Generated; every value derives from: bOn (banner 0/1), bannerPct, bannerK,
	     sysRows / gameRows and the screen ratio. Variables evaluate in order, so keep it ordered. -->
	<variables>
		<!-- Basis of the banner height: 1 = % of the screen HEIGHT (default; 30-50 % of the width would be 53-89 % of the height at 16:9),
		     ${scrRatio} = % of the screen WIDTH. -->
		<bannerK>1</bannerK>
		<!-- ES defines screen.ratio as a NAME ("16:9"), so the numeric ratio is computed here -->
		<scrRatio>${screen.width} / ${screen.height}</scrRatio>
		<bannerH>${bannerPct} / 100 * ${bannerK}</bannerH>
		<!-- Shadow margin of assets/ui/shadow.png (px) as screen fractions -->
		<shMx>24 / ${screen.width}</shMx>
		<shMy>24 / ${screen.height}</shMy>
		<!-- Top-right capsule (network, battery, clock) and the cartel (name card), same height band -->
		<capW>0.19</capW>
		<capH>0.074</capH>
		<capY>0.026</capY>
		<capX>0.975 - ${capW}</capX>
		<ctTopX>0.025</ctTopX>
		<ctTopY>0.016</ctTopY>
		<ctW>0.46</ctW>
		<ctH>0.078</ctH>
		<ctPad>0.022</ctPad>
		<!-- Icon zone: from the cartel (or the banner) down to the help bar -->
		<zoneBottom>0.945</zoneBottom>
		<gPadV>0.012</gPadV>
		<mX>0.002</mX>
		<mY>0.004</mY>
		<tMax>0.34</tMax>   <!-- tallest tile (screen height fraction): fewer rows never inflate the icons beyond this -->
		<tAspect>1.04</tAspect> <!-- tile width / height; tiles are never narrower than this -->
		<gPeek>0.45</gPeek> <!-- part of the next tile (0..1 of its width) left visible at the right edge: the scroll hint -->
		<!-- Banner: console art full width, logo (or the cartel when there is none) in the middle -->
		<plateW>0.40</plateW>
		<plateH>${bannerH} * 0.58</plateH>
		<plateY>(${bannerH} - ${plateH}) / 2</plateY>
		<!-- Banner bottom curve: the art is drawn taller than the banner, its top edge off screen, and rounded (px) -->
		<heroF>0.033</heroF>
		<heroRad>${screen.height} * ${heroF}</heroRad>
		<heroH>${bannerH} + ${heroF}</heroH>
		<heroTop>0 - ${heroF}</heroTop>
		<heroC>(${bannerH} - ${heroF}) / 2</heroC>
		<!-- Cartel: top-left without banner; centred in the banner (where the logo goes) with it -->
		<ctX>${bOn} * (1 - ${ctW}) / 2 + (1 - ${bOn}) * ${ctTopX}</ctX>
		<ctY>${bOn} * (${bannerH} - ${ctH}) / 2 + (1 - ${bOn}) * ${ctTopY}</ctY>
		<plateX>(1 - ${plateW}) / 2</plateX>
		<!-- Info row above the grid (maker + year left, game count right): under the banner, or under the cartel without it -->
		<rowH>0.034</rowH>
		<rowY>0 + ${bOn} * (${bannerH} + 0.014) + (1 - ${bOn}) * 0.120</rowY>
		<!-- Logo drop shadow (blur steps in px as screen fractions) -->
		<lsDx>4 / ${screen.width}</lsDx>
		<lsDy>4 / ${screen.height}</lsDy>
		<lsSx>${lsStep} / ${screen.width}</lsSx>
		<lsSy>${lsStep} / ${screen.height}</lsSy>
		<bannerC>${bannerH} / 2</bannerC>
		<logoMaxW>0.34</logoMaxW>
		<logoMaxH>${plateH} * 0.74</logoMaxH>
		<!-- System icon view -->
		<sRows>${sysRows} - ${bOn} * (${sysRows} &gt; 2) * (${sysRows} - 2)</sRows> <!-- banner: at most 2 rows -->
		<sZoneY>0 + ${rowY} + ${rowH} + 0.008</sZoneY>
		<sZoneH>${zoneBottom} - ${sZoneY}</sZoneH>
		<sCellRaw>(${sZoneH} - ${gPadV} - (${sRows} - 1) * ${mY}) / ${sRows}</sCellRaw>
		<sCell>${sCellRaw} - (${sCellRaw} &gt; ${tMax}) * (${sCellRaw} - ${tMax})</sCell>
		<sGridH>${sRows} * ${sCell} + (${sRows} - 1) * ${mY} + ${gPadV}</sGridH>
		<sGridY>${sZoneY} + (${sZoneH} - ${sGridH}) / 2</sGridY>
		<sTw0>${sCell} * ${tAspect} / ${scrRatio}</sTw0>
		<sColsF>((1 - ${gPadX}) / ${sTw0} - ${gPeek}) / (1 + ${mX} / ${sTw0})</sColsF>
		<sCols>3 + (${sColsF} &gt;= 4) + (${sColsF} &gt;= 5) + (${sColsF} &gt;= 6) + (${sColsF} &gt;= 7) + (${sColsF} &gt;= 8) + (${sColsF} &gt;= 9) + (${sColsF} &gt;= 10) + (${sColsF} &gt;= 11) + (${sColsF} &gt;= 12) + (${sColsF} &gt;= 13) + (${sColsF} &gt;= 14)</sCols> <!-- floor(ColsF), clamped to 3..14: FULL columns; the next tile peeks out at the right edge -->
		<sTw>${sTw0}</sTw> <!-- tile width, screen fraction: the minimum one, so the columns sit as close as the rows -->
		<sPadR>1 - ${gPadX} - ${sCols} * ${sTw} - (${sCols} - 1) * ${mX}</sPadR> <!-- right padding = all the room left: gPeek (min) to gPeek + 1 tile widths, the scroll hint (ES clips the tiles to the grid, padding included) -->
		<!-- Game icon view -->
		<gRows>${gameRows} - ${bOn} * (${gameRows} &gt; 2) * (${gameRows} - 2)</gRows> <!-- banner: at most 2 rows -->
		<gZoneY>0 + ${rowY} + ${rowH} + 0.008</gZoneY>
		<gZoneH>${zoneBottom} - ${gZoneY}</gZoneH>
		<gCellRaw>(${gZoneH} - ${gPadV} - (${gRows} - 1) * ${mY}) / ${gRows}</gCellRaw>
		<gCell>${gCellRaw} - (${gCellRaw} &gt; ${tMax}) * (${gCellRaw} - ${tMax})</gCell>
		<gGridH>${gRows} * ${gCell} + (${gRows} - 1) * ${mY} + ${gPadV}</gGridH>
		<gGridY>${gZoneY} + (${gZoneH} - ${gGridH}) / 2</gGridY>
		<gTw0>${gCell} * ${tAspect} / ${scrRatio}</gTw0>
		<gColsF>((1 - ${gPadX}) / ${gTw0} - ${gPeek}) / (1 + ${mX} / ${gTw0})</gColsF>
		<gCols>3 + (${gColsF} &gt;= 4) + (${gColsF} &gt;= 5) + (${gColsF} &gt;= 6) + (${gColsF} &gt;= 7) + (${gColsF} &gt;= 8) + (${gColsF} &gt;= 9) + (${gColsF} &gt;= 10) + (${gColsF} &gt;= 11) + (${gColsF} &gt;= 12) + (${gColsF} &gt;= 13) + (${gColsF} &gt;= 14)</gCols> <!-- floor(ColsF), clamped to 3..14: FULL columns; the next tile peeks out at the right edge -->
		<gTw>${gTw0}</gTw> <!-- tile width, screen fraction: the minimum one, so the columns sit as close as the rows -->
		<gPadR>1 - ${gPadX} - ${gCols} * ${gTw} - (${gCols} - 1) * ${mX}</gPadR> <!-- right padding = all the room left: gPeek (min) to gPeek + 1 tile widths, the scroll hint (ES clips the tiles to the grid, padding included) -->
		<!-- Derived by the layouts (cards, cartel): -->
		<ctXi>0 + ${ctX} + ${ctPad}</ctXi>
		<ctTw>${ctW} - 2 * ${ctPad}</ctTw>
		<ctTh>0.058</ctTh>
		<ctTy>0 + ${ctY} + (${ctH} - ${ctTh}) / 2</ctTy>
		<ctTfs>0.048</ctTfs>
		<rowYearX>0.915</rowYearX>
		<rowDevX>0.615</rowDevX>
		<capR>${screen.height} * ${capH} / 2</capR>
		<capInW>0.2041 / ${scrRatio} + 0.044</capInW>
		<capInX>0 + ${capX} + (${capW} - ${capInW}) / 2 - 0.004</capInX>
		<capStackH>0.044</capStackH>
		<capStackY>0 + ${capY} + (${capH} - ${capStackH}) / 2</capStackY>
		<capShX>0 + ${capX} - ${shMx}</capShX>
		<capShY>${capY} - ${shMy}</capShY>
		<capShW>0 + ${capW} + 2 * ${shMx}</capShW>
		<capShH>0 + ${capH} + 2 * ${shMy}</capShH>
		<brandX>0 + ${capX} - 0.012</brandX>
