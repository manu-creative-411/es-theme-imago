		<lsLogo1Y>0 + 0.035 + (${lsDy} * 0)</lsLogo1Y>
		<lsLogo2X>0 + 0.025 + (${lsDx} * 0.866)</lsLogo2X>
		<lsLogo2Y>0 + 0.035 + (${lsDy} * 0.5)</lsLogo2Y>
		<lsLogo3X>0 + 0.025 + (${lsDx} * 0.5)</lsLogo3X>
		<lsLogo3Y>0 + 0.035 + (${lsDy} * 0.866)</lsLogo3Y>
		<lsLogo4X>0 + 0.025 + (${lsDx} * 0)</lsLogo4X>
		<lsLogo4Y>0 + 0.035 + (${lsDy} * 1)</lsLogo4Y>
