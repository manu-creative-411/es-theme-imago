<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- List rows: Automatic. 13 rows at font scale 1; a bigger font scale gives fewer rows (13 / scale, nearest odd number).
	     Only odd numbers: the text list keeps the selected row centred, an even count cuts the first and last rows in half. -->
	<variables>
		<listRows>19</listRows>
		<listRows if="${esFontScale} &gt;= 0.7222">17</listRows>
		<listRows if="${esFontScale} &gt;= 0.8125">15</listRows>
		<listRows if="${esFontScale} &gt;= 0.9286">13</listRows>
		<listRows if="${esFontScale} &gt;= 1.0833">11</listRows>
		<listRows if="${esFontScale} &gt;= 1.3">9</listRows>
		<listRows if="${esFontScale} &gt;= 1.625">7</listRows>
	</variables>
</theme>
