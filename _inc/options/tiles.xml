<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Tiles (iconos de sistema y caratulas): sin placa, selector neon alrededor de la IMAGEN (selectionMode=image). -->
	<variables>
		<tPad>14</tPad>            <!-- px entre la imagen y el borde del tile = ancho de la banda del neon. DEBE coincidir con TILE_BAND en tools/make_neon.py -->
		<tZoom>1.06</tZoom>        <!-- zoom del tile seleccionado -->
		<gPadX>0.014</gPadX> <!-- holgura izquierda del grid (fraccion del ancho); la derecha la calcula geometry.xml (deja ver parte del siguiente tile) -->
		<gPadY>0.020</gPadY> <!-- holgura arriba/abajo (fraccion del alto): evita que el zoom/neon se corten -->
	</variables>
</theme>
