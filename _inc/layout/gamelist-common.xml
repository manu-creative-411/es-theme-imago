<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Shared by the built-in basic and detailed views: background elements, console logo,
	     the list card and the Cocoon / iconic-style game list. Default geometry = basic (centred); gamelist-detailed.xml moves it. -->
	<view name="basic, detailed">
		<image name="e_bg" extra="true">
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<color>${bg}</color>
			<zIndex>0</zIndex>
		</image>
		<image name="e_wallpaper" extra="true">
			<path>${wallpaper}</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>1</zIndex>
		</image>
		<helpsystem name="help">
			<fontPath>${fontUI}</fontPath>
			<fontSize>0.026</fontSize>
			<pos>0.02 0.955</pos>
			<textColor>${subText}</textColor>
			<iconColor>${subText}</iconColor>
		</helpsystem>
		<!-- Console logo, top-left (lowest to highest priority; the last existing file wins, as in es-theme-iconic) -->
		<image name="logo">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh0" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>${lsLogo0X} ${lsLogo0Y}</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<color>00000040</color>
			<zIndex>49</zIndex>
		</image>
		<image name="e_logo_sh1" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>${lsLogo1X} ${lsLogo1Y}</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<color>00000022</color>
			<zIndex>49</zIndex>
		</image>
		<image name="e_logo_sh2" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>${lsLogo2X} ${lsLogo2Y}</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<color>00000022</color>
			<zIndex>49</zIndex>
		</image>
		<image name="e_logo_sh3" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>${lsLogo3X} ${lsLogo3Y}</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<color>0000001C</color>
			<zIndex>49</zIndex>
		</image>
		<image name="e_logo" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>0.025 0.035</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>50</zIndex>
		</image>
		<text name="logoText">
			<fontPath>${fontTitle}</fontPath>
			<visible>false</visible>
		</text>
		<!-- ===== List card: shadow + tinted body + sheen (iconic texture) ===== -->
		<ninepatch name="e_list_panel_sh" extra="true">
			<path>${themePath}/assets/ui/shadow.png</path>
			<pos>${e_list_panelShX} ${e_list_panelShY}</pos>
			<size>${e_list_panelShW} ${e_list_panelShH}</size>
			<cornerSize>40 40</cornerSize>
			<color>${shadowColor}</color>
			<zIndex>18</zIndex>
		</ninepatch>
		<rectangle name="e_list_panel" extra="true">
			<pos>${basicPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${basicPanelH}</size>
			<color>${panelTop}</color>
			<borderColor>${panelEdge}</borderColor>
			<borderSize>1</borderSize>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>19</zIndex>
		</rectangle>
		<image name="e_list_panel_gl" extra="true">
			<path>${themePath}/assets/ui/sheen.png</path>
			<pos>${basicPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${basicPanelH}</size>
			<color>${panelBot}</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</image>
		<!-- Rows: iconic-style item template. Selected row = flat tinted pill with a hairline edge; hairline separators;
		     title shortened with "..." when unselected and scrolling when selected. Entries without game data (the ". ." parent
		     folder) have no template and use the built-in rendering with the same colours. -->
		<textlist name="gamelist">
			<pos>${basicListX} ${listY}</pos>
			<size>${listW} ${basicListH}</size>
			<lines>${listRows}</lines>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${listFontSize}</fontSize>
			<alignment>left</alignment>
			<horizontalMargin>0.016</horizontalMargin>
			<selectorColor>${rowSel}</selectorColor>
			<selectedColor>${text}</selectedColor>
			<primaryColor>${subText}</primaryColor>
			<secondaryColor>${dimText}</secondaryColor>
			<scrollbarColor>${thumb}</scrollbarColor>
			<scrollbarSize>0.0045</scrollbarSize>
			<scrollbarCorner>0.5</scrollbarCorner>
			<scrollbarAlignment>outer right</scrollbarAlignment>
			<zIndex>40</zIndex>
			<itemTemplate>
				<!-- Rectangles ignore "opacity": states are switched with fully transparent colours. -->
				<rectangle name="list-row-sep">
					<pos>0.04 0.985</pos>
					<size>0.92 ${listSepH}</size>
					<color>${rowSep}</color>
					<storyboard event="activate">
						<animation property="color" to="${rowSep}00" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${rowSep}" duration="0"/>
					</storyboard>
				</rectangle>
				<rectangle name="list-row-selector">
					<pos>0 0.06</pos>
					<size>1 0.88</size>
					<color>${rowSel}00</color>
					<borderColor>${rowSelEdge}00</borderColor>
					<borderSize>1</borderSize>
					<roundCorners>${listRadius}</roundCorners>
					<storyboard event="activate">
						<animation property="color" to="${rowSel}FF" duration="0"/>
						<animation property="borderColor" to="${rowSelEdge}" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${rowSel}00" duration="0"/>
						<animation property="borderColor" to="${rowSelEdge}00" duration="0"/>
					</storyboard>
				</rectangle>
				<text name="list-row-title">
					<text>{game:fullName}</text>
					<pos>0.04 0</pos>
					<size>0.92 1</size>
					<fontPath>${fontMedium}</fontPath>
					<fontSize>${listFontSize}</fontSize>
					<color>${subText}</color>
					<alignment>left</alignment>
					<verticalAlignment>center</verticalAlignment>
					<multiLine>false</multiLine>
					<autoScroll>none</autoScroll>
					<autoScrollDelay>1500</autoScrollDelay>
					<autoScrollSpeed>50</autoScrollSpeed>
					<storyboard event="activate">
						<animation property="color" to="${text}" duration="0"/>
						<animation property="autoScroll" to="horizontal" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${subText}" duration="0"/>
						<animation property="autoScroll" to="none" duration="0"/>
					</storyboard>
				</text>
			</itemTemplate>
		</textlist>
		<!-- ===== Built-in metadata: everything hidden by default (each view turns on what it uses) ===== -->
		<text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_lbl_gametime, md_lbl_favorite">
			<visible>false</visible>
		</text>
		<text name="md_name, md_developer, md_publisher, md_genre, md_players, md_playcount, md_gametime, md_favorite, md_description">
			<visible>false</visible>
		</text>
		<datetime name="md_releasedate, md_lastplayed">
			<visible>false</visible>
		</datetime>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<image name="md_image">
			<visible>false</visible>
		</image>
		<video name="md_video">
			<visible>false</visible>
		</video>
	</view>
</theme>
