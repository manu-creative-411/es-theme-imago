<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- System view: one horizontal strip of folder icons pinned to the bottom half.
	     NOTE: stock EmulationStation only offers a single-row <carousel> here (no multi-row grid). -->
	<view name="system">
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.5</pos>
			<size>1 0.42</size>
			<color>00000000</color>
			<logoSize>0.14 0.26</logoSize>
			<logoScale>1.15</logoScale>
			<logoAlignment>center</logoAlignment>
			<maxLogoCount>7</maxLogoCount>
			<systemInfoDelay>800</systemInfoDelay>
		</carousel>
		<!-- Folder icons: assets/systems/<system.theme>.svg (drawn by hand). Falls back to logoText. -->
		<image name="logo">
			<path>${themePath}/assets/systems/${system.theme}.svg</path>
		</image>
		<text name="logoText">
			<color>${text}</color>
			<fontSize>0.04</fontSize>
			<forceUppercase>true</forceUppercase>
		</text>
		<text name="systemInfo">
			<pos>0.5 0.34</pos>
			<origin>0.5 0</origin>
			<size>0.8 0.05</size>
			<color>${subText}</color>
			<fontSize>0.035</fontSize>
			<alignment>center</alignment>
		</text>
		<text name="e_system_name" extra="true">
			<text>${system.fullName}</text>
			<pos>0.5 0.22</pos>
			<origin>0.5 0</origin>
			<size>0.9 0.1</size>
			<color>${text}</color>
			<fontSize>0.07</fontSize>
			<alignment>center</alignment>
			<zIndex>45</zIndex>
		</text>
	</view>
</theme>
