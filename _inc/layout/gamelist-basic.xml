<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Elementos comunes de las vistas Basic y Detailed: fondo, marca, reloj, logo de consola y ayuda (copiados de common.xml). -->
	<variables>
		<basicListX>0.5</basicListX>
	</variables>
	<view name="basic, detailed">
		<image name="e_bg" extra="true">
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<color>${bg}</color>
			<zIndex>0</zIndex>
		</image>
		<image name="e_wallpaper" extra="true">
			<path>${wallpaper}</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>1</zIndex>
		</image>
		<image name="e_brand" extra="true">
			<path>${brandLogo}</path>
			<pos>0.915 0.03</pos>
			<origin>1 0</origin>
			<maxSize>0.14 0.06</maxSize>
			<horizontalAlignment>right</horizontalAlignment>
			<zIndex>60</zIndex>
		</image>
		<text name="clock">
			<fontPath>${fontUI}</fontPath>
			<pos>0.98 0.03</pos>
			<origin>1 0</origin>
			<color>${subText}</color>
			<fontSize>0.028</fontSize>
			<alignment>right</alignment>
		</text>
		<helpsystem name="help">
			<fontPath>${fontUI}</fontPath>
			<fontSize>0.026</fontSize>
			<pos>0.02 0.955</pos>
			<textColor>${subText}</textColor>
			<iconColor>${subText}</iconColor>
		</helpsystem>
	
		<!-- Console logo, top-left. Several <path>: from LOWEST to HIGHEST priority, the last one that exists wins (same logic as es-theme-iconic).
		     Order: <sys>.svg < <sys>-<region>.svg < <sys>/jp < jp-scheme < us < us-scheme < eu < eu-scheme < <scheme> < <region> < <scheme>-<region>.svg -->
		<image name="logo">
			<visible>false</visible>
		</image>
		<image name="e_logo" extra="true">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoColorScheme}-${logoRegion}.svg</path>
			<pos>0.025 0.035</pos>
			<origin>0 0</origin>
			<maxSize>0.16 0.08</maxSize>
			<horizontalAlignment>left</horizontalAlignment>
			<zIndex>50</zIndex>
		</image>
		<text name="logoText">
			<fontPath>${fontTitle}</fontPath>
			<visible>false</visible>
		</text>
		</view>

	<!-- Vista "basic": lista centrada, con desarrolladora y año del juego seleccionado. -->
	<view name="basic">
		<textlist name="gamelist">
			<fontPath>${fontTitle}</fontPath>
			<selectorColor>00000000</selectorColor>
			<selectedColor>${accentText}</selectedColor>
			<primaryColor>${subText}</primaryColor>
			<secondaryColor>${dimText}</secondaryColor>
			<horizontalMargin>0.01</horizontalMargin>
			<zIndex>40</zIndex>
			<pos>${basicListX} 0.42</pos>
			<origin>0.5 0.5</origin>
			<size>0.46 0.62</size>
			<fontSize>0.05</fontSize>
			<lines>7</lines>
			<alignment>center</alignment>
			<itemTemplate>
				<image name="list-row-selector">
					<path>${themePath}/assets/ui/round.png</path>
					<pos>0 0</pos>
					<size>1 1</size>
					<color>${accent}00</color>
					<storyboard event="activate">
						<animation property="color" to="${accent}FF" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${accent}00" duration="0"/>
					</storyboard>
				</image>
				<text name="list-row-title">
					<text>{game:fullName}</text>
					<pos>0.02 0</pos>
					<size>0.96 1</size>
					<fontPath>${fontTitle}</fontPath>
					<fontSize>0.05</fontSize>
					<color>${subText}</color>
					<alignment>center</alignment>
					<verticalAlignment>center</verticalAlignment>
					<multiLine>false</multiLine>
					<autoScroll>none</autoScroll>
					<autoScrollDelay>1500</autoScrollDelay>
					<autoScrollSpeed>50</autoScrollSpeed>
					<storyboard event="activate">
						<animation property="color" to="${accentText}" duration="0"/>
						<animation property="autoScroll" to="horizontal" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${subText}" duration="0"/>
						<animation property="autoScroll" to="none" duration="0"/>
					</storyboard>
				</text>
			</itemTemplate>
		</textlist>
		<text name="md_developer">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.5 0.86</pos>
			<origin>0.5 0</origin>
			<size>0.46 0.03</size>
			<color>${subText}</color>
			<fontSize>0.028</fontSize>
			<alignment>center</alignment>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.5 0.90</pos>
			<origin>0.5 0</origin>
			<size>0.46 0.03</size>
			<format>%Y</format>
			<color>${dimText}</color>
			<fontSize>0.028</fontSize>
			<alignment>center</alignment>
			<zIndex>45</zIndex>
		</datetime>
	</view>
</theme>
