<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Basic view: the centred list of gamelist-common.xml as is (the built-in basic view cannot show metadata).
	     "Imago Basic": same list plus developer and year of the selected game below the card. It inherits "detailed"
	     (only a detailed-based view can show metadata), so it must undo the detailed layout. Include AFTER gamelist-detailed.xml. -->
	<customView name="Imago Basic" inherits="detailed">
		<ninepatch name="e_list_panel_sh" extra="true">
			<pos>${listBasShX} ${listBasShY}</pos>
			<size>${listBasShW} ${listBasShH}</size>
		</ninepatch>
		<rectangle name="e_list_panel">
			<pos>${basicPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${basicPanelH}</size>
		</rectangle>
		<image name="e_list_panel_gl" extra="true">
			<pos>${basicPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${basicPanelH}</size>
		</image>
		<textlist name="gamelist">
			<pos>${basicListX} ${listY}</pos>
			<size>${listW} ${basicListH}</size>
		</textlist>
		<rectangle name="e_info_card, e_desc_card">
			<visible>false</visible>
		</rectangle>
		<ninepatch name="e_info_card_sh, e_desc_card_sh">
			<visible>false</visible>
		</ninepatch>
		<image name="e_info_card_gl, e_desc_card_gl">
			<visible>false</visible>
		</image>
		<text name="e_cap_developer, e_cap_publisher, e_cap_year, e_cap_rating">
			<visible>false</visible>
		</text>
		<image name="md_image">
			<visible>false</visible>
		</image>
		<text name="md_publisher, md_description">
			<visible>false</visible>
		</text>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<text name="md_developer">
			<pos>0.5 0.875</pos>
			<origin>0.5 0</origin>
			<size>0.42 0.035</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${text}</color>
			<alignment>center</alignment>
		</text>
		<datetime name="md_releasedate">
			<pos>0.5 0.910</pos>
			<origin>0.5 0</origin>
			<size>0.42 0.030</size>
			<fontPath>${fontInfo}</fontPath>
			<fontSize>0.024</fontSize>
			<color>${dimText}</color>
			<alignment>center</alignment>
		</datetime>
	</customView>
</theme>
