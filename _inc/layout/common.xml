<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Shared look: flat background, help bar, game tiles, menu. Branding + status capsule: chrome.xml. -->
	<view name="system, grid">
		<image name="e_bg" extra="true">
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<color>${bg}</color>
			<zIndex>0</zIndex>
		</image>
		<image name="e_wallpaper" extra="true">
			<path>${wallpaper}</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>1</zIndex>
		</image>
		<helpsystem name="help">
			<fontPath>${fontUI}</fontPath>
			<fontSize>0.026</fontSize>
			<pos>0.02 0.955</pos>
			<textColor>${subText}</textColor>
			<iconColor>${subText}</iconColor>
		</helpsystem>
	</view>

	<!-- Tiles (game icons). Neon selector = assets/ui/neon.png (nine-patch, tinted with ${neon}); see _inc/options/tiles.xml. -->
	<view name="grid">
		<!-- The console logo of the icon views lives in the banner / cartel (gamelist-grid.xml); the built-in one is hidden. -->
		<image name="logo">
			<visible>false</visible>
		</image>
		<text name="logoText">
			<fontPath>${fontTitle}</fontPath>
			<visible>false</visible>
		</text>
		<gridtile name="default">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>00000000</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<gridtile name="selected">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>${neon}</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
	</view>

	<view name="menu">
		<menuBackground name="menubg">
			<color>${box}F2</color>
		</menuBackground>
		<menuText name="menutext">
			<fontPath>${fontMenuItem}</fontPath>
			<fontSize>0.027</fontSize>
			<color>${text}</color>
			<selectedColor>${text}</selectedColor>
			<selectorColor>${neon}59</selectorColor>
			<separatorColor>${subText}55</separatorColor>
		</menuText>
		<menuText name="menutitle">
			<fontPath>${fontMenuTitle}</fontPath>
			<fontSize>0.036</fontSize>
			<color>${text}</color>
		</menuText>
		<menuGroup name="menugroup">
			<fontPath>${fontMenuGroup}</fontPath>
			<fontSize>0.030</fontSize>
			<color>${neon}</color>
			<separatorColor>${subText}55</separatorColor>
			<backgroundColor>00000000</backgroundColor>
		</menuGroup>
		<menuText name="menufooter">
			<fontPath>${fontMenuSmall}</fontPath>
			<fontSize>0.021</fontSize>
			<color>${subText}</color>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<fontPath>${fontMenuSmall}</fontPath>
			<fontSize>0.022</fontSize>
			<color>${subText}</color>
		</menuTextSmall>
		<menuTextEdit name="menutextedit">
			<inactive>${themePath}/assets/icons/menu-textinput.png</inactive>
			<active>${themePath}/assets/icons/menu-textinput-active.png</active>
		</menuTextEdit>
		<menuIcons name="menuicons">
			<iconSystem>${themePath}/assets/icons/menu-icon-system.svg</iconSystem>
			<iconUpdates>${themePath}/assets/icons/menu-icon-update.svg</iconUpdates>
			<iconControllers>${themePath}/assets/icons/menu-icon-controller.svg</iconControllers>
			<iconGames>${themePath}/assets/icons/menu-icon-games.svg</iconGames>
			<iconUI>${themePath}/assets/icons/menu-icon-ui.svg</iconUI>
			<iconSound>${themePath}/assets/icons/menu-icon-sound.svg</iconSound>
			<iconNetwork>${themePath}/assets/icons/menu-icon-network.svg</iconNetwork>
			<iconScraper>${themePath}/assets/icons/menu-icon-scraper.svg</iconScraper>
			<iconAdvanced>${themePath}/assets/icons/menu-icon-advanced.svg</iconAdvanced>
			<iconQuit>${themePath}/assets/icons/menu-icon-quit.svg</iconQuit>
			<iconRetroachievements>${themePath}/assets/icons/menu-icon-achievements.svg</iconRetroachievements>
			<iconKodi>${themePath}/assets/icons/menu-icon-kodi.svg</iconKodi>
			<iconRestart>${themePath}/assets/icons/menu-icon-restart.svg</iconRestart>
			<iconShutdown>${themePath}/assets/icons/menu-icon-shutdown.svg</iconShutdown>
			<iconFastShutdown>${themePath}/assets/icons/menu-icon-shutdown.svg</iconFastShutdown>
		</menuIcons>
	</view>
</theme>
