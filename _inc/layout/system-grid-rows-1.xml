<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- System view, 1 row(s): [banner: console art + logo] / info strip / icon grid. -->
	<view name="system">
		<imagegrid name="imagegrid">
			<pos>0 ${gY1}</pos>
			<size>1 ${gH1}</size>
			<padding>${gPad}</padding>
			<autoLayout>${gC1} 1</autoLayout>
			<margin>${gM1}</margin>
			<autoLayoutSelectedZoom>${tZoom}</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
		<gridtile name="default">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>00000000</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<gridtile name="selected">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>${neon}</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<!-- Tile content: system icon (_inc/system_icons/<system.theme>.svg), text fallback -->
		<image name="logo">
			<path>${themePath}/_inc/system_icons/${system.theme}.svg</path>
		</image>
		<text name="logoText">
			<color>${text}</color>
			<fontSize>0.04</fontSize>
			<forceUppercase>true</forceUppercase>
		</text>
		<!-- BANNER (rows 1-2 only; always visible in system view) -->
		<image name="e_hero_default" extra="true">
			<path>${themePath}/_inc/system_bg/${system.theme}.jpg</path>
			<visible>true</visible>
			<pos>0.5 ${bC1}</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 ${bH1}</minSize>
			<zIndex>29</zIndex>
		</image>
		<image name="e_overflow" extra="true">
			<visible>true</visible>
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 ${bH1}</pos>
			<size>1 ${bR1}</size>
			<color>${bg}</color>
			<zIndex>31</zIndex>
		</image>
		<image name="e_overflow_wp" extra="true">
			<visible>true</visible>
			<path>${wallpaperB1}</path>
			<pos>0 ${bH1}</pos>
			<size>1 ${bR1}</size>
			<zIndex>31.5</zIndex>
		</image>
		<image name="e_corner_l" extra="true">
			<visible>true</visible>
			<path>${themePath}/assets/ui/corner-bl.png</path>
			<pos>0 ${bH1}</pos>
			<origin>0 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="e_corner_r" extra="true">
			<visible>true</visible>
			<path>${themePath}/assets/ui/corner-br.png</path>
			<pos>1 ${bH1}</pos>
			<origin>1 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="e_syslogo" extra="true">
			<path>${themePath}/_inc/system_logos/${tone}-${region}/${system.theme}.svg</path>
			<default>${themePath}/_inc/system_logos/${tone}-eu/${system.theme}.svg</default>
			<visible>true</visible>
			<pos>0.5 ${bY1}</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 ${bB1}</maxSize>
			<zIndex>35</zIndex>
		</image>
		<!-- Info strip: system name | manufacturer | release year | game count -->
		<text name="e_sys_name" extra="true">
			<text>${system.fullName}</text>
			<pos>0.02 ${gT1}</pos>
			<origin>0 0</origin>
			<size>0.31 0.036</size>
			<color>${text}</color>
			<fontSize>0.036</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_sys_maker" extra="true">
			<text>${system.manufacturer}</text>
			<pos>0.34 ${gU1}</pos>
			<origin>0 0</origin>
			<size>0.15 0.030</size>
			<color>${subText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_sys_year" extra="true">
			<text>${system.releaseYear}</text>
			<pos>0.50 ${gU1}</pos>
			<origin>0 0</origin>
			<size>0.12 0.030</size>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.64 ${gU1}</pos>
			<origin>0 0</origin>
			<size>0.20 0.030</size>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
	</view>
</theme>
