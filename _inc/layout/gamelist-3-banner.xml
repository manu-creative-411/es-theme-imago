<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Game list, 3 row(s), with banner (photo + marquee). Self-contained: no ifSubset anywhere; the option is chosen by which file is included. -->
	<customView name="Imago" inherits="grid">
		<!-- Banner: photo cropped to 100% x 0.286 (cover); console art (_inc/system_bg) when the game has no image -->
		<image name="e_hero_default" extra="true">
			<path>firstfile("${themePath}/_inc/system_bg/${system.theme}.png", "${themePath}/_inc/system_bg/${system.theme}.svg", "${themePath}/_inc/system_bg/${system.theme}.jpg", "${themePath}/_inc/system_bg/${system.theme}.webp")</path>
			<visible>!exists({game:image})</visible>
			<pos>0.5 0.143</pos>
			<origin>0.5 0.5</origin>
			<maxSize>1 0.286</maxSize>
			<zIndex>29</zIndex>
		</image>
		<image name="md_image">
			<pos>0.5 0.143</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 0.286</minSize>
			<zIndex>30</zIndex>
		</image>
		<image name="e_overflow" extra="true">
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 0.286</pos>
			<size>1 0.714</size>
			<color>${bg}</color>
			<zIndex>31</zIndex>
		</image>
		<image name="e_corner_l" extra="true">
			<path>${themePath}/assets/ui/corner-bl.png</path>
			<pos>0 0.286</pos>
			<origin>0 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="e_corner_r" extra="true">
			<path>${themePath}/assets/ui/corner-br.png</path>
			<pos>1 0.286</pos>
			<origin>1 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<!-- Marquee; without one, the rounded box (default image) shows with the game name over it -->
		<image name="md_marquee">
			<default>${themePath}/assets/ui/${boxFile}-h17.svg</default>
			<pos>0.5 0.040</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 0.170</maxSize>
			<zIndex>35</zIndex>
		</image>
		<text name="e_box_name" extra="true">
			<text>{game:name}</text>
			<visible>!exists({game:marquee})</visible>
			<pos>0.5 0.125</pos>
			<origin>0.5 0.5</origin>
			<size>0.38 0.058</size>
			<color>${text}</color>
			<fontSize>0.058</fontSize>
			<alignment>center</alignment>
			<zIndex>36</zIndex>
		</text>
		<!-- Info strip: name (2-33%, ellipsis) | developer (from 34%) | year (from 50%) -->
		<text name="md_name">
			<pos>0.02 0.315</pos>
			<origin>0 0</origin>
			<size>0.31 0.036</size>
			<color>${text}</color>
			<fontSize>0.036</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<pos>0.34 0.319</pos>
			<origin>0 0</origin>
			<size>0.15 0.030</size>
			<color>${subText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.50 0.319</pos>
			<origin>0 0</origin>
			<size>0.12 0.030</size>
			<format>%Y</format>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<imagegrid name="gamegrid">
			<pos>0.02 0.380</pos>
			<size>0.96 0.560</size>
			<autoLayout>9 3</autoLayout>
			<autoLayoutSelectedZoom>1.08</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<margin>0.004 0.006</margin>
			<imageSource>thumbnail</imageSource>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
	</customView>
</theme>
