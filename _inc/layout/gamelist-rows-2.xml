<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Game list, 2 row(s). Geometry comes from the Banner option variables (gY2, gH2...). No ifSubset. -->
	<customView name="Imago" inherits="grid">
		<!-- BANNER (rows 1-2 only; toggled by the 'Banner' option through ${bVis}) -->
		<image name="e_hero_default" extra="true">
			<path>${themePath}/_inc/system_bg/${system.theme}.jpg</path>
			<visible>${bHeroVis}</visible>
			<pos>0.5 ${bC2}</pos>
			<origin>0.5 0.5</origin>
			<maxSize>1 ${bH2}</maxSize>
			<zIndex>29</zIndex>
		</image>
		<image name="md_image">
			<visible>${bVis}</visible>
			<pos>0.5 ${bC2}</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 ${bH2}</minSize>
			<zIndex>30</zIndex>
		</image>
		<image name="e_overflow" extra="true">
			<visible>${bVis}</visible>
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 ${bH2}</pos>
			<size>1 ${bR2}</size>
			<color>${bg}</color>
			<zIndex>31</zIndex>
		</image>
		<image name="e_overflow_wp" extra="true">
			<visible>${bVis}</visible>
			<path>${wallpaperB2}</path>
			<pos>0 ${bH2}</pos>
			<size>1 ${bR2}</size>
			<zIndex>31.5</zIndex>
		</image>
		<image name="e_corner_l" extra="true">
			<visible>${bVis}</visible>
			<path>${themePath}/assets/ui/corner-bl.png</path>
			<pos>0 ${bH2}</pos>
			<origin>0 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="e_corner_r" extra="true">
			<visible>${bVis}</visible>
			<path>${themePath}/assets/ui/corner-br.png</path>
			<pos>1 ${bH2}</pos>
			<origin>1 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="md_marquee">
			<visible>${bVis}</visible>
			<default>${themePath}/assets/ui/${boxFile}-${bF2}.svg</default>
			<pos>0.5 ${bY2}</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 ${bB2}</maxSize>
			<zIndex>35</zIndex>
		</image>
		<text name="e_box_name" extra="true">
			<text>{game:name}</text>
			<visible>${bNameVis}</visible>
			<pos>0.5 ${bCY2}</pos>
			<origin>0.5 0.5</origin>
			<size>0.38 ${bFS2}</size>
			<color>${text}</color>
			<fontSize>${bFS2}</fontSize>
			<alignment>center</alignment>
			<zIndex>36</zIndex>
		</text>
		<!-- Info strip: name (2-33%, ellipsis) | developer (from 34%) | year (from 50%) -->
		<text name="md_name">
			<pos>0.02 ${gT2}</pos>
			<origin>0 0</origin>
			<size>0.31 0.036</size>
			<color>${text}</color>
			<fontSize>0.036</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<pos>0.34 ${gU2}</pos>
			<origin>0 0</origin>
			<size>0.15 0.030</size>
			<color>${subText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.50 ${gU2}</pos>
			<origin>0 0</origin>
			<size>0.12 0.030</size>
			<format>%Y</format>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<imagegrid name="gamegrid">
			<pos>0 ${gY2}</pos>
			<size>1 ${gH2}</size>
			<padding>${gPad}</padding>
			<autoLayout>${gC2} 2</autoLayout>
			<margin>${gM2}</margin>
			<imageSource>thumbnail</imageSource>
			<autoLayoutSelectedZoom>${tZoom}</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
	</customView>
</theme>
