<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Game list, 2 row(s). Tiles are ordered top-to-bottom, then left-to-right (scrollDirection=horizontal). -->
	<customView name="Imago" inherits="grid">
		<!-- Top half: photo cropped to 100% x 50% of the screen (cover, centred). Overflow below 50% is hidden by e_overflow. -->
		<image name="md_image">
			<pos>0.5 0.25</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 0.5</minSize>
			<zIndex>30</zIndex>
		</image>
		<image name="e_overflow" extra="true">
			<path>${themePath}/assets/ui/white.png</path>
			<pos>0 0.5</pos>
			<size>1 0.5</size>
			<color>${bg}</color>
			<zIndex>31</zIndex>
		</image>
		<!-- Rounded bottom corners of the photo: 36px @1080p = 0.01875 x 0.03333 of the screen. -->
		<image name="e_corner_l" extra="true">
			<path>${themePath}/assets/ui/corner-bl.png</path>
			<pos>0 0.5</pos>
			<origin>0 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<image name="e_corner_r" extra="true">
			<path>${themePath}/assets/ui/corner-br.png</path>
			<pos>1 0.5</pos>
			<origin>1 1</origin>
			<size>0.01875 0.033333</size>
			<color>${bg}</color>
			<zIndex>32</zIndex>
		</image>
		<!-- Info texts. The rounded box is the DEFAULT of md_marquee, so it is only drawn when the game has no marquee. -->
		<text name="md_name">
			<pos>0.5 0.057</pos>
			<origin>0.5 0</origin>
			<size>0.40 0.085</size>
			<color>${text}</color>
			<fontSize>0.061</fontSize>
			<alignment>center</alignment>
			<zIndex>34</zIndex>
		</text>
		<text name="md_developer">
			<pos>0.494 0.149</pos>
			<origin>1 0</origin>
			<size>0.19 0.041</size>
			<color>${subText}</color>
			<fontSize>0.032</fontSize>
			<alignment>right</alignment>
			<zIndex>34</zIndex>
		</text>
		<text name="e_subtitle_sep" extra="true">
			<text>-</text>
			<pos>0.5 0.149</pos>
			<origin>0.5 0</origin>
			<size>0.012 0.041</size>
			<color>${subText}</color>
			<fontSize>0.032</fontSize>
			<alignment>center</alignment>
			<zIndex>34</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.506 0.149</pos>
			<origin>0 0</origin>
			<size>0.19 0.041</size>
			<format>%Y</format>
			<color>${subText}</color>
			<fontSize>0.032</fontSize>
			<alignment>left</alignment>
			<zIndex>34</zIndex>
		</datetime>
		<image name="md_marquee">
			<default>${themePath}/assets/ui/${boxFile}-h17.svg</default>
			<pos>0.5 0.040</pos>
			<origin>0.5 0</origin>
			<maxSize>0.42 0.170</maxSize>
			<zIndex>33</zIndex>
		</image>
		<imagegrid name="gamegrid">
			<pos>0.02 0.48</pos>
			<size>0.96 0.46</size>
			<autoLayout>7 2</autoLayout>
			<autoLayoutSelectedZoom>1.08</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<margin>0.004 0.006</margin>
			<imageSource>thumbnail</imageSource>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
	</customView>
</theme>
