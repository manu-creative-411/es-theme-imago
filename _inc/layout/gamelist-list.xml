<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Lista vertical de juegos (arriba a abajo), estilo Imago.
	     Se elige como vista de lista en el menú de estilo de vista de EmulationStation ("Imago List").
	     Fila seleccionada = selector neon (assets/ui/neon.png, tintado con ${neon}); título con elipsis / desplazamiento.
	     Hereda el fondo, logo de consola y ayuda de la vista "grid" (common.xml). -->
	<customView name="Imago List" inherits="grid">
		<textlist name="gamelist">
			<fontPath>${fontTitle}</fontPath>
			<selectorColor>00000000</selectorColor>
			<selectedColor>${text}</selectedColor>
			<primaryColor>${subText}</primaryColor>
			<secondaryColor>${dimText}</secondaryColor>
			<horizontalMargin>0.02</horizontalMargin>
			<zIndex>40</zIndex>
			<pos>0.20 0.22</pos>
			<size>0.78 0.68</size>
			<fontSize>0.040</fontSize>
			<lines>7</lines>
			<alignment>left</alignment>
			<itemTemplate>
				<image name="list-row-selector" extra="true">
					<path>${themePath}/assets/ui/neon.png</path>
					<pos>0 0</pos>
					<size>1 1</size>
					<color>${neon}00</color>
					<storyboard event="activate">
						<animation property="color" to="${neon}FF" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${neon}00" duration="0"/>
					</storyboard>
				</image>
				<text name="list-row-title">
					<text>{game:fullName}</text>
					<pos>0.025 0</pos>
					<size>0.950 1</size>
					<fontPath>${fontTitle}</fontPath>
					<fontSize>0.040</fontSize>
					<color>${subText}</color>
					<alignment>left</alignment>
					<verticalAlignment>center</verticalAlignment>
					<multiLine>false</multiLine>
					<autoScroll>none</autoScroll>
					<autoScrollDelay>1500</autoScrollDelay>
					<autoScrollSpeed>50</autoScrollSpeed>
					<storyboard event="activate">
						<animation property="color" to="${text}" duration="0"/>
						<animation property="autoScroll" to="horizontal" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${subText}" duration="0"/>
						<animation property="autoScroll" to="none" duration="0"/>
					</storyboard>
				</text>
			</itemTemplate>
		</textlist>
	</customView>
</theme>
