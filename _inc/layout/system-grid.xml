<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- System view, icon grid. Banner (optional) + cartel + icon grid, all derived in geometry.xml. -->
	<view name="system" if="${sysCarousel} == 0">
		<imagegrid name="imagegrid">
			<pos>0 ${sGridY}</pos>
			<size>1 ${sGridH}</size>
			<padding>${gPadX} ${gPadY} ${sPadR} ${gPadY}</padding>
			<autoLayout>${sCols} ${sRows}</autoLayout>
			<margin>${mX} ${mY}</margin>
			<autoLayoutSelectedZoom>${tZoom}</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
		<gridtile name="default">
			<backgroundImage>${themePath}/assets/ui/neon-${neonSet}.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>00000000</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<gridtile name="selected">
			<backgroundImage>${themePath}/assets/ui/neon-${neonSet}.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>FFFFFFFF</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<!-- Tile content: system icon, text fallback -->
		<image name="logo">
			<path>${themePath}/_inc/system_icons/_folder.svg</path>
			<path>${themePath}/_inc/system_icons/${system.theme}.svg</path>
			<path>${themePath}/_inc/icons_${iconSet}/${system.theme}.jpg</path>
		</image>
		<text name="logoText">
			<fontPath>${fontTitle}</fontPath>
			<color>${text}</color>
			<fontSize>0.034</fontSize>
			<forceUppercase>true</forceUppercase>
		</text>
		<!-- Info row above the grid: maker + year on the left, game count (ES fills systemInfo) on the right. Always shown. -->
		<text name="systemInfo">
			<pos>0.975 ${rowY}</pos>
			<origin>1 0</origin>
			<size>0.3 ${rowH}</size>
			<fontPath>${fontInfo}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${subText}</color>
			<backgroundColor>00000000</backgroundColor>
			<alignment>right</alignment>
			<zIndex>45</zIndex>
		</text>
		<!-- Banner -->
		<image name="e_hero" extra="true" if="${bOn} == 1">
			<path>${themePath}/_inc/system_bg/${system.theme}.jpg</path>
			<pos>0.5 ${heroC}</pos>
			<origin>0.5 0.5</origin>
			<minSize>1 ${heroH}</minSize>
			<roundCorners>${heroRad}</roundCorners>
			<zIndex>29</zIndex>
		</image>
		<rectangle name="e_hero_dim" extra="true" if="${bOn} == 1">
			<pos>0 ${heroTop}</pos>
			<size>1 ${heroH}</size>
			<color>00000040</color>
			<borderSize>0</borderSize>
			<roundCorners>${heroRad}</roundCorners>
			<zIndex>29.5</zIndex>
		</rectangle>
		<image name="e_syslogo_sh0" extra="true" if="${bOn} == 1">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
