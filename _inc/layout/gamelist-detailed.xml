<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Detailed view: list card on the right, game info on the left.
	     Shown: image, developer, publisher, year, rating, description. Geometry variables: _inc/options/list.xml.
	     Cards = shadow + tinted body + sheen. -->
	<view name="detailed">
		<ninepatch name="e_list_panel_sh" extra="true">
			<pos>${listDetShX} ${listDetShY}</pos>
			<size>${listDetShW} ${listDetShH}</size>
		</ninepatch>
		<rectangle name="e_list_panel">
			<pos>${listPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${listPanelH}</size>
		</rectangle>
		<image name="e_list_panel_gl" extra="true">
			<pos>${listPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${listPanelH}</size>
		</image>
		<textlist name="gamelist">
			<pos>${listX} ${listY}</pos>
			<size>${listW} ${listH}</size>
		</textlist>
		<!-- Console logo: centred above the game image, larger than in basic -->
		<!-- No shadow under the console logo in this view -->
		<image name="e_logo_sh0" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh1" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh2" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh3" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh4" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh5" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh6" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh7" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh8" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh9" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh10" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh11" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo_sh12" extra="true">
			<visible>false</visible>
		</image>
		<image name="e_logo" extra="true">
			<pos>0.28 0.14</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.36 0.17</maxSize>
			<horizontalAlignment>center</horizontalAlignment>
		</image>
		<ninepatch name="e_img_card_sh" extra="true">
			<path>${themePath}/assets/ui/shadow.png</path>
			<pos>${e_img_cardShX} ${e_img_cardShY}</pos>
			<size>${e_img_cardShW} ${e_img_cardShH}</size>
			<cornerSize>40 40</cornerSize>
			<color>${shadowColor}</color>
			<zIndex>18</zIndex>
		</ninepatch>
		<rectangle name="e_img_card" extra="true">
			<pos>0.025 0.25</pos>
			<size>0.31 0.44</size>
			<color>${panelTop}</color>
			<borderColor>${panelEdge}</borderColor>
			<borderSize>1</borderSize>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>19</zIndex>
		</rectangle>
		<image name="e_img_card_gl" extra="true">
			<path>${themePath}/assets/ui/sheen.png</path>
			<pos>0.025 0.25</pos>
			<size>0.31 0.44</size>
			<color>${panelBot}</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</image>
		<image name="md_image">
			<visible>true</visible>
			<pos>0.18 0.47</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.29 0.42</maxSize>
			<default>${themePath}/_inc/system_bg/${system.theme}.jpg</default>
			<roundCorners>${cardRadius}</roundCorners>
			<linearSmooth>true</linearSmooth>
			<zIndex>30</zIndex>
		</image>
		<ninepatch name="e_info_card_sh" extra="true">
			<path>${themePath}/assets/ui/shadow.png</path>
			<pos>${e_info_cardShX} ${e_info_cardShY}</pos>
			<size>${e_info_cardShW} ${e_info_cardShH}</size>
			<cornerSize>40 40</cornerSize>
			<color>${shadowColor}</color>
			<zIndex>18</zIndex>
		</ninepatch>
		<rectangle name="e_info_card" extra="true">
			<pos>0.36 0.25</pos>
			<size>0.175 0.44</size>
			<color>${panelTop}</color>
			<borderColor>${panelEdge}</borderColor>
			<borderSize>1</borderSize>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>19</zIndex>
		</rectangle>
		<image name="e_info_card_gl" extra="true">
			<path>${themePath}/assets/ui/sheen.png</path>
			<pos>0.36 0.25</pos>
			<size>0.175 0.44</size>
			<color>${panelBot}</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</image>
		<text name="e_cap_developer" extra="true">
			<text>${i18nDeveloper}</text>
			<fontPath>${fontSemiBold}</fontPath>
			<pos>0.375 0.28</pos>
			<size>0.145 0.028</size>
			<color>${dimText}</color>
			<fontSize>0.018</fontSize>
			<alignment>left</alignment>
			<multiLine>false</multiLine>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_publisher" extra="true">
			<text>${i18nPublisher}</text>
			<fontPath>${fontSemiBold}</fontPath>
			<pos>0.375 0.38</pos>
			<size>0.145 0.028</size>
			<color>${dimText}</color>
			<fontSize>0.018</fontSize>
			<alignment>left</alignment>
			<multiLine>false</multiLine>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_year" extra="true">
			<text>${i18nYear}</text>
			<fontPath>${fontSemiBold}</fontPath>
			<pos>0.375 0.48</pos>
			<size>0.145 0.028</size>
			<color>${dimText}</color>
			<fontSize>0.018</fontSize>
			<alignment>left</alignment>
			<multiLine>false</multiLine>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_rating" extra="true">
			<text>${i18nRating}</text>
			<fontPath>${fontSemiBold}</fontPath>
			<pos>0.375 0.58</pos>
			<size>0.145 0.028</size>
			<color>${dimText}</color>
			<fontSize>0.018</fontSize>
			<alignment>left</alignment>
			<multiLine>false</multiLine>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<fontPath>${fontMedium}</fontPath>
			<pos>0.375 0.308</pos>
			<size>0.145 0.040</size>
			<color>${text}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<autoScroll>horizontal</autoScroll>
			<autoScrollDelay>1500</autoScrollDelay>
			<autoScrollSpeed>50</autoScrollSpeed>
			<singleLineScroll>true</singleLineScroll>
			<visible>true</visible>
			<zIndex>45</zIndex>
		</text>
		<text name="md_publisher">
			<fontPath>${fontMedium}</fontPath>
			<pos>0.375 0.408</pos>
			<size>0.145 0.040</size>
			<color>${text}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<autoScroll>horizontal</autoScroll>
			<autoScrollDelay>1500</autoScrollDelay>
			<autoScrollSpeed>50</autoScrollSpeed>
			<singleLineScroll>true</singleLineScroll>
			<visible>true</visible>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<visible>true</visible>
			<pos>0.375 0.508</pos>
			<size>0.145 0.040</size>
			<format>%Y</format>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${text}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<rating name="md_rating">
			<visible>true</visible>
			<pos>0.375 0.614</pos>
			<size>0 0.028</size>
			<filledPath>${themePath}/assets/icons/star.svg</filledPath>
			<unfilledPath>${themePath}/assets/icons/star.svg</unfilledPath>
			<color>${text}</color>
			<unfilledColor>${dimText}66</unfilledColor>
			<zIndex>45</zIndex>
		</rating>
		<ninepatch name="e_desc_card_sh" extra="true">
			<path>${themePath}/assets/ui/shadow.png</path>
			<pos>${e_desc_cardShX} ${e_desc_cardShY}</pos>
			<size>${e_desc_cardShW} ${e_desc_cardShH}</size>
			<cornerSize>40 40</cornerSize>
			<color>${shadowColor}</color>
			<zIndex>18</zIndex>
		</ninepatch>
		<rectangle name="e_desc_card" extra="true">
			<pos>0.025 0.73</pos>
			<size>0.51 0.20</size>
			<color>${panelTop}</color>
			<borderColor>${panelEdge}</borderColor>
			<borderSize>1</borderSize>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>19</zIndex>
		</rectangle>
		<image name="e_desc_card_gl" extra="true">
			<path>${themePath}/assets/ui/sheen.png</path>
			<pos>0.025 0.73</pos>
			<size>0.51 0.20</size>
			<color>${panelBot}</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</image>
		<text name="md_description">
			<visible>true</visible>
			<pos>0.045 0.745</pos>
			<size>0.47 0.176</size>
			<fontPath>${fontInfo}</fontPath>
			<fontSize>0.024</fontSize>
			<color>${subText}</color>
			<alignment>left</alignment>
			<lineSpacing>1.3</lineSpacing>
			<autoScroll>vertical</autoScroll>
			<autoScrollDelay>2500</autoScrollDelay>
			<autoScrollSpeed>25</autoScrollSpeed>
			<zIndex>45</zIndex>
		</text>
	</view>
</theme>
