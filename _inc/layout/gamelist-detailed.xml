<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<detailListX>0.575</detailListX>
	</variables>
	<!-- Vista "detailed": game info on the left (image, name, metadata, description), list on the right.
	     List geometry and panel are the same as the "Vertical list" option (taken from es-theme-iconic). -->
	<view name="detailed">
		<image name="list-panel" extra="true">
			<path>${themePath}/assets/list/gamelist-panel-${logoColorScheme}.png</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>20</zIndex>
		</image>
		<image name="md_image">
			<pos>0.04 0.09</pos>
			<origin>0 0</origin>
			<maxSize>0.46 0.40</maxSize>
			<zIndex>30</zIndex>
		</image>
		<text name="md_name">
			<fontPath>${fontTitle}</fontPath>
			<pos>0.04 0.52</pos>
			<origin>0 0</origin>
			<size>0.46 0.05</size>
			<color>${text}</color>
			<fontSize>0.042</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.59</pos>
			<origin>0 0</origin>
			<size>0.46 0.03</size>
			<color>${text}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_publisher">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.63</pos>
			<origin>0 0</origin>
			<size>0.46 0.03</size>
			<color>${subText}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.67</pos>
			<origin>0 0</origin>
			<size>0.46 0.03</size>
			<format>%Y</format>
			<color>${subText}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<text name="md_genre">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.71</pos>
			<origin>0 0</origin>
			<size>0.46 0.03</size>
			<color>${subText}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_players">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.75</pos>
			<origin>0 0</origin>
			<size>0.46 0.03</size>
			<color>${subText}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_description">
			<fontPath>${fontInfo}</fontPath>
			<pos>0.04 0.80</pos>
			<origin>0 0</origin>
			<size>0.46 0.12</size>
			<color>${dimText}</color>
			<fontSize>0.023</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<textlist name="gamelist">
			<fontPath>${fontTitle}</fontPath>
			<selectorColor>00000000</selectorColor>
			<selectedColor>${accentText}</selectedColor>
			<primaryColor>${subText}</primaryColor>
			<secondaryColor>${dimText}</secondaryColor>
			<horizontalMargin>0.008333333333333</horizontalMargin>
			<zIndex>40</zIndex>
			<pos>${detailListX} 0.09</pos>
			<size>0.362 0.7519</size>
			<fontSize>0.065</fontSize>
			<lines>7</lines>
			<alignment>left</alignment>
			<itemTemplate>
				<image name="list-row-selector">
					<path>${themePath}/assets/ui/round.png</path>
					<pos>0 0</pos>
					<size>1 1</size>
					<color>${accent}00</color>
					<storyboard event="activate">
						<animation property="color" to="${accent}FF" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${accent}00" duration="0"/>
					</storyboard>
				</image>
				<text name="list-row-title">
					<text>{game:fullName}</text>
					<pos>0.023 0</pos>
					<size>0.954 1</size>
					<fontPath>${fontTitle}</fontPath>
					<fontSize>0.065</fontSize>
					<color>${subText}</color>
					<alignment>left</alignment>
					<verticalAlignment>center</verticalAlignment>
					<multiLine>false</multiLine>
					<autoScroll>none</autoScroll>
					<autoScrollDelay>1500</autoScrollDelay>
					<autoScrollSpeed>50</autoScrollSpeed>
					<storyboard event="activate">
						<animation property="color" to="${accentText}" duration="0"/>
						<animation property="autoScroll" to="horizontal" duration="0"/>
					</storyboard>
					<storyboard event="deactivate">
						<animation property="color" to="${subText}" duration="0"/>
						<animation property="autoScroll" to="none" duration="0"/>
					</storyboard>
				</text>
			</itemTemplate>
		</textlist>
	</view>
</theme>
