<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Detailed view (also "Imago Detailed"): list panel on the right, game info on the left.
	     Info shown: image, developer, publisher, year, rating, description. Nothing else (the rest stays hidden,
	     see gamelist-common.xml). Geometry variables in _inc/options/list.xml.

	     0.025                       0.535  0.555                     0.975
	     +=============================+    +=========================+  0.13
	     |           md_image          |    |                         |
	     |                             |    |        game list        |
	     +=============================+    |      (rounded pill      |  0.56
	     | DEVELOPER PUBLISHER YEAR RAT|    |       on selection)     |  0.585
	     +=============================+    |                         |  0.70
	     |        md_description       |    |                         |  0.72
	     +=============================+    +=========================+  0.93 -->
	<view name="detailed">
		<rectangle name="e_list_panel">
			<pos>${listPanelX} ${listPanelY}</pos>
			<size>${listPanelW} ${listPanelH}</size>
		</rectangle>
		<textlist name="gamelist">
			<pos>${listX} ${listY}</pos>
			<size>${listW} ${listH}</size>
		</textlist>

		<!-- Image: md_image (screenshot); the console art is the fallback -->
		<image name="md_image">
			<visible>true</visible>
			<pos>0.28 0.345</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.51 0.43</maxSize>
			<default>${themePath}/_inc/system_bg/${system.theme}.jpg</default>
			<roundCorners>0.025</roundCorners>
			<linearSmooth>true</linearSmooth>
			<zIndex>30</zIndex>
		</image>

		<!-- Info card: developer | publisher | year | rating -->
		<rectangle name="e_info_card">
			<pos>0.025 0.585</pos>
			<size>0.51 0.115</size>
			<color>${tile}E6</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</rectangle>
		<text name="e_cap_developer" extra="true">
			<text>${i18nDeveloper}</text>
			<pos>0.045 0.600</pos>
			<size>0.13 0.028</size>
			<fontPath>${fontSemiBold}</fontPath>
			<fontSize>0.018</fontSize>
			<color>${dimText}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_publisher" extra="true">
			<text>${i18nPublisher}</text>
			<pos>0.190 0.600</pos>
			<size>0.17 0.028</size>
			<fontPath>${fontSemiBold}</fontPath>
			<fontSize>0.018</fontSize>
			<color>${dimText}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_year" extra="true">
			<text>${i18nYear}</text>
			<pos>0.375 0.600</pos>
			<size>0.05 0.028</size>
			<fontPath>${fontSemiBold}</fontPath>
			<fontSize>0.018</fontSize>
			<color>${dimText}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_cap_rating" extra="true">
			<text>${i18nRating}</text>
			<pos>0.440 0.600</pos>
			<size>0.09 0.028</size>
			<fontPath>${fontSemiBold}</fontPath>
			<fontSize>0.018</fontSize>
			<color>${dimText}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<visible>true</visible>
			<pos>0.045 0.632</pos>
			<size>0.13 0.040</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${text}</color>
			<alignment>left</alignment>
			<autoScroll>horizontal</autoScroll>
			<autoScrollDelay>1500</autoScrollDelay>
			<autoScrollSpeed>50</autoScrollSpeed>
			<singleLineScroll>true</singleLineScroll>
			<zIndex>45</zIndex>
		</text>
		<text name="md_publisher">
			<visible>true</visible>
			<pos>0.190 0.632</pos>
			<size>0.17 0.040</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${text}</color>
			<alignment>left</alignment>
			<autoScroll>horizontal</autoScroll>
			<autoScrollDelay>1500</autoScrollDelay>
			<autoScrollSpeed>50</autoScrollSpeed>
			<singleLineScroll>true</singleLineScroll>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<visible>true</visible>
			<pos>0.375 0.632</pos>
			<size>0.05 0.040</size>
			<format>%Y</format>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${text}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<rating name="md_rating">
			<visible>true</visible>
			<pos>0.440 0.638</pos>
			<size>0 0.028</size>
			<filledPath>${themePath}/assets/icons/star.svg</filledPath>
			<unfilledPath>${themePath}/assets/icons/star.svg</unfilledPath>
			<color>${text}</color>
			<unfilledColor>${dimText}66</unfilledColor>
			<zIndex>45</zIndex>
		</rating>

		<!-- Description card -->
		<rectangle name="e_desc_card">
			<pos>0.025 0.72</pos>
			<size>0.51 0.21</size>
			<color>${tile}E6</color>
			<roundCorners>${cardRadius}</roundCorners>
			<zIndex>20</zIndex>
		</rectangle>
		<text name="md_description">
			<visible>true</visible>
			<pos>0.045 0.737</pos>
			<size>0.47 0.176</size>
			<fontPath>${fontInfo}</fontPath>
			<fontSize>0.024</fontSize>
			<lineSpacing>1.3</lineSpacing>
			<color>${subText}</color>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
	</view>

	<!-- Selectable view style; same layout as the built-in detailed view. -->
	<customView name="Imago Detailed" inherits="detailed">
	</customView>
</theme>
