			<path>${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg</path>
			<pos>${lsGame24X} ${lsGame24Y}</pos>
			<origin>0.5 0.5</origin>
			<maxSize>${logoMaxW} ${logoMaxH}</maxSize>
			<color>000000${lsA3}</color>
			<visible>{game:name} != '' &amp;&amp; !exists({game:marquee})</visible>
			<zIndex>34</zIndex>
		</image>
		<image name="e_syslogo" extra="true" if="${bOn} == 1">
			<path>${themePath}/_inc/system_logos/${system.theme}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark-jp.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark-us.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg</path>
			<path>${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg</path>
			<visible>{game:name} != '' &amp;&amp; !exists({game:marquee})</visible>
			<pos>0.5 ${bannerC}</pos>
			<origin>0.5 0.5</origin>
			<maxSize>${logoMaxW} ${logoMaxH}</maxSize>
			<zIndex>35</zIndex>
		</image>
		<!-- Cartel (console name only): no banner, or banner with neither a game logo nor a console logo -->
		<ninepatch name="cartelg_sh" extra="true">
			<path>${themePath}/assets/ui/shadow.png</path>
			<pos>${cartelgShX} ${cartelgShY}</pos>
			<size>${cartelgShW} ${cartelgShH}</size>
			<cornerSize>40 40</cornerSize>
			<color>${shadowColor}</color>
			<visible>{game:name} != '' &amp;&amp; ${bOn} == 1 &amp;&amp; !exists({game:marquee}) &amp;&amp; (firstfile('${themePath}/_inc/system_logos/${system.theme}.svg', '${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/jp.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-jp.svg', '${themePath}/_inc/system_logos/${system.theme}/us.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-us.svg', '${themePath}/_inc/system_logos/${system.theme}/eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark.svg', '${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg') == '')</visible>
			<zIndex>18</zIndex>
		</ninepatch>
		<rectangle name="cartelg" extra="true">
			<pos>${ctX} ${ctY}</pos>
			<size>${ctW} ${ctH}</size>
			<color>${panelTop}</color>
			<borderColor>${panelEdge}</borderColor>
			<borderSize>1</borderSize>
			<roundCorners>${cardRadius}</roundCorners>
			<visible>{game:name} != '' &amp;&amp; ${bOn} == 1 &amp;&amp; !exists({game:marquee}) &amp;&amp; (firstfile('${themePath}/_inc/system_logos/${system.theme}.svg', '${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/jp.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-jp.svg', '${themePath}/_inc/system_logos/${system.theme}/us.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-us.svg', '${themePath}/_inc/system_logos/${system.theme}/eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark.svg', '${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg') == '')</visible>
			<zIndex>19</zIndex>
		</rectangle>
		<image name="cartelg_gl" extra="true">
			<path>${themePath}/assets/ui/sheen.png</path>
			<pos>${ctX} ${ctY}</pos>
			<size>${ctW} ${ctH}</size>
			<color>${panelBot}</color>
			<roundCorners>${cardRadius}</roundCorners>
			<visible>{game:name} != '' &amp;&amp; ${bOn} == 1 &amp;&amp; !exists({game:marquee}) &amp;&amp; (firstfile('${themePath}/_inc/system_logos/${system.theme}.svg', '${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/jp.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-jp.svg', '${themePath}/_inc/system_logos/${system.theme}/us.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-us.svg', '${themePath}/_inc/system_logos/${system.theme}/eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark.svg', '${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg') == '')</visible>
			<zIndex>20</zIndex>
		</image>
		<text name="e_sys_name" extra="true">
			<text>${system.fullName}</text>
			<fontPath>${fontTitle}</fontPath>
			<pos>${ctXi} ${ctTy}</pos>
			<size>${ctTw} ${ctTh}</size>
			<color>${text}</color>
			<fontSize>${ctTfs}</fontSize>
			<alignment>center</alignment>
			<multiLine>false</multiLine>
			<visible>{game:name} != '' &amp;&amp; ${bOn} == 1 &amp;&amp; !exists({game:marquee}) &amp;&amp; (firstfile('${themePath}/_inc/system_logos/${system.theme}.svg', '${themePath}/_inc/system_logos/${system.theme}-${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/jp.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-jp.svg', '${themePath}/_inc/system_logos/${system.theme}/us.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-us.svg', '${themePath}/_inc/system_logos/${system.theme}/eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-eu.svg', '${themePath}/_inc/system_logos/${system.theme}/dark.svg', '${themePath}/_inc/system_logos/${system.theme}/${logoRegion}.svg', '${themePath}/_inc/system_logos/${system.theme}/dark-${logoRegion}.svg') == '')</visible>
			<zIndex>45</zIndex>
		</text>
		<text name="e_sys_name_nb" extra="true" if="${bOn} == 0">
			<text>${system.fullName}</text>
			<fontPath>${fontTitle}</fontPath>
			<pos>0.025 0.034</pos>
			<size>0.55 ${ctTh}</size>
			<color>${text}</color>
			<fontSize>${ctTfs}</fontSize>
			<alignment>left</alignment>
			<multiLine>false</multiLine>
			<visible>{game:name} != ''</visible>
			<zIndex>45</zIndex>
		</text>
		<!-- Info row: selected game name (left); developer and year (right) -->
		<text name="md_name">
			<fontPath>${fontMedium}</fontPath>
			<pos>0.025 ${rowY}</pos>
			<size>0.56 ${rowH}</size>
			<color>${text}</color>
			<fontSize>0.026</fontSize>
			<alignment>left</alignment>
			<autoScroll>horizontal</autoScroll>
			<autoScrollDelay>1500</autoScrollDelay>
			<autoScrollSpeed>50</autoScrollSpeed>
			<singleLineScroll>true</singleLineScroll>
			<visible>{game:name} != ''</visible>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<fontPath>${fontInfo}</fontPath>
			<pos>${rowDevX} ${rowY}</pos>
			<size>0.30 ${rowH}</size>
			<color>${subText}</color>
			<fontSize>0.026</fontSize>
			<alignment>right</alignment>
			<multiLine>false</multiLine>
			<visible>{game:name} != ''</visible>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>${rowYearX} ${rowY}</pos>
			<size>0.06 ${rowH}</size>
			<format>%Y</format>
			<fontPath>${fontInfo}</fontPath>
			<fontSize>0.026</fontSize>
			<color>${dimText}</color>
			<alignment>right</alignment>
			<visible>{game:name} != ''</visible>
			<zIndex>45</zIndex>
		</datetime>
		<imagegrid name="gamegrid">
			<pos>0 ${gGridY}</pos>
			<size>1 ${gGridH}</size>
			<padding>${gPadX} ${gPadY} ${gPadR} ${gPadY}</padding>
			<autoLayout>${gCols} ${gRows}</autoLayout>
			<margin>${mX} ${mY}</margin>
			<imageSource>thumbnail</imageSource>
			<autoLayoutSelectedZoom>${tZoom}</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
	</customView>
</theme>
