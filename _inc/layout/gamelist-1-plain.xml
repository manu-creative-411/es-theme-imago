<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Game list, 1 row(s), plain (no banner). Self-contained: no ifSubset anywhere; the option is chosen by which file is included. -->
	<customView name="Imago" inherits="grid">
		<!-- Info strip: name (2-33%, ellipsis) | developer (from 34%) | year (from 50%) -->
		<text name="md_name">
			<pos>0.02 0.455</pos>
			<origin>0 0</origin>
			<size>0.31 0.036</size>
			<color>${text}</color>
			<fontSize>0.036</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="md_developer">
			<pos>0.34 0.460</pos>
			<origin>0 0</origin>
			<size>0.15 0.030</size>
			<color>${subText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.50 0.460</pos>
			<origin>0 0</origin>
			<size>0.12 0.030</size>
			<format>%Y</format>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</datetime>
		<imagegrid name="gamegrid">
			<pos>0.02 0.520</pos>
			<size>0.96 0.420</size>
			<autoLayout>4 1</autoLayout>
			<autoLayoutSelectedZoom>1.08</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<margin>0.004 0.006</margin>
			<imageSource>thumbnail</imageSource>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
	</customView>
</theme>
