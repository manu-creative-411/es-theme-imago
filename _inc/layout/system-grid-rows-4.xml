<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- System view, 4 row(s): [banner: console art + logo] / info strip / icon grid. -->
	<view name="system">
		<imagegrid name="imagegrid">
			<pos>0 ${gY4}</pos>
			<size>1 ${gH4}</size>
			<padding>${gPad}</padding>
			<autoLayout>${gC4} 4</autoLayout>
			<margin>${gM4}</margin>
			<autoLayoutSelectedZoom>${tZoom}</autoLayoutSelectedZoom>
			<scrollDirection>horizontal</scrollDirection>
			<centerSelection>false</centerSelection>
			<scrollLoop>false</scrollLoop>
			<animateSelection>true</animateSelection>
			<zIndex>40</zIndex>
		</imagegrid>
		<gridtile name="default">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>00000000</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<gridtile name="selected">
			<backgroundImage>${themePath}/assets/ui/neon.png</backgroundImage>
			<backgroundCornerSize>${tPad} ${tPad}</backgroundCornerSize>
			<backgroundColor>${neon}</backgroundColor>
			<selectionMode>image</selectionMode>
			<imageSizeMode>maxSize</imageSizeMode>
			<padding>${tPad} ${tPad}</padding>
		</gridtile>
		<!-- Tile content: system icon (_inc/system_icons/<system.theme>.svg), text fallback -->
		<image name="logo">
			<path>${themePath}/_inc/system_icons/${system.theme}.svg</path>
		</image>
		<text name="logoText">
			<color>${text}</color>
			<fontSize>0.04</fontSize>
			<forceUppercase>true</forceUppercase>
		</text>
		<!-- Info strip: system name | manufacturer | release year | game count -->
		<text name="e_sys_name" extra="true">
			<text>${system.fullName}</text>
			<pos>0.02 ${gT4}</pos>
			<origin>0 0</origin>
			<size>0.31 0.036</size>
			<color>${text}</color>
			<fontSize>0.036</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_sys_maker" extra="true">
			<text>${system.manufacturer}</text>
			<pos>0.34 ${gU4}</pos>
			<origin>0 0</origin>
			<size>0.15 0.030</size>
			<color>${subText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="e_sys_year" extra="true">
			<text>${system.releaseYear}</text>
			<pos>0.50 ${gU4}</pos>
			<origin>0 0</origin>
			<size>0.12 0.030</size>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.64 ${gU4}</pos>
			<origin>0 0</origin>
			<size>0.20 0.030</size>
			<color>${dimText}</color>
			<fontSize>0.030</fontSize>
			<alignment>left</alignment>
			<zIndex>45</zIndex>
		</text>
	</view>
</theme>
