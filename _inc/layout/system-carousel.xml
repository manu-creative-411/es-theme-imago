<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- System view fallback: single-row carousel of icons (_inc/system_icons). -->
	<view name="system">
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.5</pos>
			<size>1 0.42</size>
			<color>00000000</color>
			<logoSize>0.14 0.26</logoSize>
			<logoScale>1.15</logoScale>
			<logoAlignment>center</logoAlignment>
			<maxLogoCount>7</maxLogoCount>
			<systemInfoDelay>800</systemInfoDelay>
		</carousel>
		<image name="logo">
			<path>${themePath}/_inc/system_icons/${system.theme}.svg</path>
		</image>
		<text name="logoText">
			<color>${text}</color>
			<fontSize>0.04</fontSize>
			<forceUppercase>true</forceUppercase>
		</text>
		<!-- Console art (_inc/system_bg/<system>.png|svg|jpg|webp), per system -->
		<image name="e_hero" extra="true">
			<path>firstfile("${themePath}/_inc/system_bg/${system.theme}.png", "${themePath}/_inc/system_bg/${system.theme}.svg", "${themePath}/_inc/system_bg/${system.theme}.jpg", "${themePath}/_inc/system_bg/${system.theme}.webp")</path>
			<pos>0.5 0.100</pos>
			<origin>0.5 0</origin>
			<maxSize>0.6 0.280</maxSize>
			<zIndex>30</zIndex>
		</image>
		<text name="e_system_name" extra="true">
			<text>${system.fullName}</text>
			<pos>0.5 0.370</pos>
			<origin>0.5 0</origin>
			<size>0.9 0.065</size>
			<color>${text}</color>
			<fontSize>0.065</fontSize>
			<alignment>center</alignment>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.5 0.450</pos>
			<origin>0.5 0</origin>
			<size>0.8 0.028</size>
			<color>${subText}</color>
			<fontSize>0.028</fontSize>
			<alignment>center</alignment>
		</text>
	</view>
</theme>
