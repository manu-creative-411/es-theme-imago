<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Light gray. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>D4D4DA</bg>             <!-- flat page background (single colour) -->
		<tile>FFFFFF</tile>         <!-- unselected tile / folder backdrop -->
		<accent>3A3A46</accent>     <!-- selected tile highlight -->
		<accentText>FFFFFF</accentText> <!-- text drawn on top of the accent colour -->
		<text>22222B</text>         <!-- primary text -->
		<subText>6B6B78</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>FFFFFF</box>           <!-- rounded info box -->
			<boxFile>box-light-gray</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>9A9AA6</dimText>   <!-- tertiary text (year column) -->
		<tone>light</tone>         <!-- light|dark: picks _inc/system_logos/<system>/<tone>.svg -->
		<scheme>light-gray</scheme>     <!-- picks _inc/system_logos/<system>/<scheme>-<region>.svg -->
		<dimText>9A9AA6</dimText>   <!-- tertiary text (year column) -->
		<tone>light</tone>         <!-- light|dark: picks _inc/system_logos/<system>/<tone>.svg -->
		<scheme>light-gray</scheme>     <!-- picks _inc/system_logos/<system>/<scheme>-<region>.svg -->
		<wallpaper>${themePath}/assets/wallpapers/none.png</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/none.png</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/none.png</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>6A2CFF</neon>         <!-- color del selector neon (contorno + resplandor) -->
	</variables>
</theme>
