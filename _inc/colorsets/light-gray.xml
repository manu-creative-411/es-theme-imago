<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Light gray. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>D4D4DA</bg>             <!-- flat page background (single colour) -->
		<tile>FFFFFF</tile>         <!-- unselected tile / folder backdrop -->
		<accent>3A3A46</accent>     <!-- selected tile highlight -->
		<accentText>FFFFFF</accentText> <!-- text drawn on top of the accent colour -->
		<text>22222B</text>         <!-- primary text -->
		<subText>6B6B78</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>FFFFFF</box>           <!-- rounded info box -->
			<boxFile>box-light-gray</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>9A9AA6</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/light-gray.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/light-gray-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/light-gray-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>2EE6C0</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<logoColorScheme>light</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>FFFFFF</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>F0F0F0</panelBot>             <!-- card body, bottom -->
		<panelEdge>00000020</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>2A2A3CB0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>DFDFE1</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>00000030</rowSelEdge>
		<rowSep>22222B1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>22222BC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
