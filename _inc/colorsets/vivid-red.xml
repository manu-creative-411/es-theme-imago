<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Vivid red. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>E10B24</bg>             <!-- flat page background (single colour) -->
		<tile>A3101F</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>B3001A</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>FFC9CF</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>4D000A</box>           <!-- rounded info box -->
			<boxFile>box-vivid-red</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>FF8E99</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/vivid-red.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/vivid-red-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/vivid-red-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>FFADB7</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>FF5266</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>9B1826</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>FABEC5</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>vivid-red</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<lsStep>4</lsStep> <!-- logo drop shadow (gamelist views): blur step in px, then alpha (hex) of the centre and the three rings -->
		<lsA0>14</lsA0> <lsA1>0E</lsA1> <lsA2>0A</lsA2> <lsA3>06</lsA3>
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>AA2331</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>8C0E1B</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>B23643</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>FFFFFF1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>FFFFFFC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
