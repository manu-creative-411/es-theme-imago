<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Black. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>0B0B0F</bg>             <!-- flat page background (single colour) -->
		<tile>262631</tile>         <!-- unselected tile / folder backdrop -->
		<accent>E6E6EE</accent>     <!-- selected tile highlight -->
		<accentText>111118</accentText> <!-- text drawn on top of the accent colour -->
		<text>F2F2F7</text>         <!-- primary text -->
		<subText>A0A0AD</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>2A2A32</box>           <!-- rounded info box -->
			<boxFile>box-black</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>6C6C7A</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/dark.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/dark-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/dark-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>9B6BFF</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>3F36F0</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>2C2C35</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>AF8CF6</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>black</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<lsSmooth>0</lsSmooth> <!-- 1: smooth 0,0 shadow under the console logo of the detailed view -->
		<lsStep>3</lsStep> <!-- its ring step in px, then alpha (hex) of the centre and the 4 rings -->
		<lsA0>1C</lsA0> <lsA1>14</lsA1> <lsA2>0C</lsA2> <lsA3>07</lsA3> <lsA4>04</lsA4>
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>373741</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>21212A</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>45454F</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>F2F2F71E</rowSep>                 <!-- hairline between list rows -->
		<thumb>F2F2F7C0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
