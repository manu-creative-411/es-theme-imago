<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Black. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>0B0B0F</bg>             <!-- flat page background (single colour) -->
		<tile>262631</tile>         <!-- unselected tile / folder backdrop -->
		<accent>E6E6EE</accent>     <!-- selected tile highlight -->
		<accentText>111118</accentText> <!-- text drawn on top of the accent colour -->
		<text>F2F2F7</text>         <!-- primary text -->
		<subText>A0A0AD</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>000000</box>           <!-- rounded info box -->
			<boxFile>box-black</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>6C6C7A</dimText>   <!-- tertiary text (year column) -->
		<tone>dark</tone>         <!-- light|dark: picks _inc/system_logos/<system>/<tone>.svg -->
		<scheme>black</scheme>     <!-- picks _inc/system_logos/<system>/<scheme>-<region>.svg -->
		<dimText>6C6C7A</dimText>   <!-- tertiary text (year column) -->
		<tone>dark</tone>         <!-- light|dark: picks _inc/system_logos/<system>/<tone>.svg -->
		<scheme>black</scheme>     <!-- picks _inc/system_logos/<system>/<scheme>-<region>.svg -->
		<wallpaper>${themePath}/assets/wallpapers/dark.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/dark-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/dark-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
	</variables>
</theme>
