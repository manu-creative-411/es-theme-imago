<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Orange. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>FF6A00</bg>             <!-- flat page background (single colour) -->
		<tile>D04A00</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>C03C00</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>FFE3CC</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>4A1E00</box>           <!-- rounded info box -->
			<boxFile>box-orange</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>FFB27A</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/orange.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/orange-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/orange-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>FFD2A3</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>FF9419</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>C34C0A</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>FEE1CD</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>orange</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<lsSmooth>1</lsSmooth> <!-- 1: smooth 0,0 shadow under the console logo of the detailed view -->
		<lsStep>3</lsStep> <!-- its ring step in px, then alpha (hex) of the centre and the 4 rings -->
		<lsA0>1C</lsA0> <lsA1>14</lsA1> <lsA2>0C</lsA2> <lsA3>07</lsA3> <lsA4>04</lsA4>
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>D45814</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>B34000</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>923400</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>FFFFFF1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>FFFFFFC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
