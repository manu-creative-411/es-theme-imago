<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Aqua green. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>14C9B0</bg>             <!-- flat page background (single colour) -->
		<tile>0A8F82</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>036B62</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>CFFFF6</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>013B37</box>           <!-- rounded info box -->
			<boxFile>box-aqua-green</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>8BE9DA</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/aqua-green.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/aqua-green-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/aqua-green-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>FF2E9A</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>1E988C</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>097B70</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>07645B</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>FFFFFF1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>FFFFFFC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
