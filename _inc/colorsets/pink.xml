<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Pink. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>F0599B</bg>             <!-- flat page background (single colour) -->
		<tile>B0346F</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>A31F5C</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>FFD3E6</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>4A0F2C</box>           <!-- rounded info box -->
			<boxFile>box-pink</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>FF9CC4</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/pink.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/pink-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/pink-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>6D0331</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>A9044C</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>A6386D</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>FDE6F0</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>pink</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>B6447B</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>972D5F</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>BB5083</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>FFFFFF1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>FFFFFFC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
