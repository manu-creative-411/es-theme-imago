<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Deep blue. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>0A56D6</bg>             <!-- flat page background (single colour) -->
		<tile>0C3C9A</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>0A3FA8</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>BFD5FF</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>031638</box>           <!-- rounded info box -->
			<boxFile>box-deep-blue</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>86A9F0</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/none.png</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/none.png</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/none.png</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>7DF9FF</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
	</variables>
</theme>
