<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Deep blue. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>0A56D6</bg>             <!-- flat page background (single colour) -->
		<tile>0C3C9A</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>0A3FA8</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>BFD5FF</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>031638</box>           <!-- rounded info box -->
			<boxFile>box-deep-blue</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>86A9F0</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/deep-blue.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/deep-blue-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/deep-blue-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>ADCCFF</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>5292FF</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>144093</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>9FC0F7</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>deep-blue</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>dark</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>1F4CA2</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>0A3484</panelBot>             <!-- card body, bottom -->
		<panelEdge>FFFFFF2A</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>000000F0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>335BAA</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>FFFFFF3C</rowSelEdge>
		<rowSep>FFFFFF1E</rowSep>                 <!-- hairline between list rows -->
		<thumb>FFFFFFC0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
