<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Deep blue. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>0A56D6</bg>             <!-- flat page background (single colour) -->
		<tile>0C3C9A</tile>         <!-- unselected tile / folder backdrop -->
		<accent>FFFFFF</accent>     <!-- selected tile highlight -->
		<accentText>0A3FA8</accentText> <!-- text drawn on top of the accent colour -->
		<text>FFFFFF</text>         <!-- primary text -->
		<subText>BFD5FF</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>031638</box>           <!-- rounded info box -->
			<boxFile>box-deep-blue</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
	</variables>
</theme>
