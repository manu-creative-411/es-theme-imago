<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<!-- Colour set: Yellow. All colours are RRGGBB; alpha is appended where used. -->
	<variables>
		<bg>F5C518</bg>             <!-- flat page background (single colour) -->
		<tile>FBE27A</tile>         <!-- unselected tile / folder backdrop -->
		<accent>3A3100</accent>     <!-- selected tile highlight -->
		<accentText>FFFFFF</accentText> <!-- text drawn on top of the accent colour -->
		<text>2A2400</text>         <!-- primary text -->
		<subText>5E4E00</subText>   <!-- secondary text (subtitle, help bar) -->
		<box>FFEB99</box>           <!-- rounded info box -->
			<boxFile>box-yellow</boxFile> <!-- assets/ui/box-<set>-h??.svg, default info box -->
		<dimText>8A7410</dimText>   <!-- tertiary text (year column) -->
		<wallpaper>${themePath}/assets/wallpapers/yellow.svg</wallpaper> <!-- assets/wallpapers/: fondo a pantalla completa (none.png = sin fondo) -->
		<wallpaperB1>${themePath}/assets/wallpapers/yellow-b1.svg</wallpaperB1> <!-- recorte bajo el banner, 1 fila -->
		<wallpaperB2>${themePath}/assets/wallpapers/yellow-b2.svg</wallpaperB2> <!-- recorte bajo el banner, 2 filas -->
		<neon>FFFBD6</neon>         <!-- color del selector neon (contorno + resplandor) -->
		<neon2>FFF08A</neon2>        <!-- second colour of the selection frame gradient (baked by tools/make_neon.py) -->
		<menuBg>F3DC76</menuBg> <!-- menu background: the list views' card colour (average of panelTop and panelBot); text on the selected bar uses it too -->
		<menuAccent>6B5609</menuAccent> <!-- menu: selected-item bar, group titles, subtitles and footers; a shade of the set colour with contrast >= 5 against <box> (the menu background and the selected item's text) -->
		<neonSet>yellow</neonSet> <!-- suffix of assets/ui/neon-<set>.png and neon-row-<set>.png (see tools/make_neon.py) -->
		<logoColorScheme>light</logoColorScheme> <!-- dark|light: picks <system>/<scheme>[-<region>].svg in _inc/system_logos -->
		<lsSmooth>0</lsSmooth> <!-- 1: smooth 0,0 shadow under the console logo of the detailed view -->
		<lsStep>3</lsStep> <!-- its ring step in px, then alpha (hex) of the centre and the 4 rings -->
		<lsA0>40</lsA0> <lsA1>2C</lsA1> <lsA2>1C</lsA2> <lsA3>10</lsA3> <lsA4>08</lsA4>
		<!-- Texture (iconic-style): shadow + vertical gradient body + hairline edge, selected row, separators, scrollbar. Derived from tile / accent / text. -->
		<panelTop>FBE27A</panelTop>             <!-- card body, top of the vertical gradient -->
		<panelBot>ECD571</panelBot>             <!-- card body, bottom -->
		<panelEdge>00000020</panelEdge>          <!-- 1 px hairline around cards -->
		<shadowColor>2A2A3CB0</shadowColor>    <!-- tint of assets/ui/shadow.png (the PNG is black) -->
		<rowSel>DCC666</rowSel>                 <!-- selected list row (flat), text on it = text -->
		<rowSelEdge>00000030</rowSelEdge>
		<rowSep>2A24001E</rowSep>                 <!-- hairline between list rows -->
		<thumb>2A2400C0</thumb>                 <!-- scrollbar thumb -->
		<!-- /Texture -->
	</variables>
</theme>
