	<include>./_inc/options/fonts.xml</include>
	<include>./_inc/options/tiles.xml</include>
	<include>./_inc/layout/common.xml</include>
	<include subset="helpicons" name="default" displayName="Default (Batocera)">./_inc/help/default.xml</include>
