	<include subset="helpicons" name="snesalt" displayName="SNES alt">./_inc/help/snesalt.xml</include>
	<include subset="helpicons" name="xboxone" displayName="Xbox One">./_inc/help/xboxone.xml</include>
	<include subset="helpicons" name="arcade" displayName="Arcade">./_inc/help/arcade.xml</include>
