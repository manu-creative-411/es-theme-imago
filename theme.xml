	<include subset="colorset" name="GameCube purple" displayName="GameCube purple">./_inc/colorsets/gamecube-purple.xml</include>
	<include subset="wallpaper" name="on" displayName="On (default)">./_inc/options/wallpaper-on.xml</include>
	<include subset="wallpaper" name="off" displayName="Off">./_inc/options/wallpaper-off.xml</include>
	<include subset="branding" name="RetroBat" displayName="RetroBat">./_inc/branding/retrobat.xml</include>
