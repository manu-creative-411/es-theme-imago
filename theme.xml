<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="Imago">
	<formatVersion>7</formatVersion>
	<!-- Order matters: variables (colour set, branding) must be loaded before the layouts that use them. -->
	<include subset="colorset" name="Black" displayName="Color set: Black">./_inc/colorsets/black.xml</include>
	<include subset="colorset" name="Light gray" displayName="Color set: Light gray">./_inc/colorsets/light-gray.xml</include>
	<include subset="colorset" name="Vivid red" displayName="Color set: Vivid red">./_inc/colorsets/vivid-red.xml</include>
	<include subset="colorset" name="Deep blue" displayName="Color set: Deep blue">./_inc/colorsets/deep-blue.xml</include>
	<include subset="colorset" name="Aqua green" displayName="Color set: Aqua green">./_inc/colorsets/aqua-green.xml</include>
	<include subset="colorset" name="GameCube purple" displayName="Color set: GameCube purple">./_inc/colorsets/gamecube-purple.xml</include>
	<include subset="wallpaper" name="on" displayName="Wallpaper: on (default)">./_inc/options/wallpaper-on.xml</include>
	<include subset="wallpaper" name="off" displayName="Wallpaper: off">./_inc/options/wallpaper-off.xml</include>
	<include subset="branding" name="RetroBat" displayName="Branding: RetroBat">./_inc/branding/retrobat.xml</include>
	<include subset="branding" name="Batocera" displayName="Branding: Batocera">./_inc/branding/batocera.xml</include>
	<include subset="branding" name="Retrobox" displayName="Branding: Retrobox">./_inc/branding/retrobox.xml</include>
	<include subset="logoregion" name="eu" displayName="Console logo region: Europe (default)">./_inc/options/logoregion-eu.xml</include>
	<include subset="logoregion" name="us" displayName="Console logo region: USA">./_inc/options/logoregion-us.xml</include>
	<include subset="logoregion" name="jp" displayName="Console logo region: Japan">./_inc/options/logoregion-jp.xml</include>
	<include subset="logoregion" name="br" displayName="Console logo region: Brazil">./_inc/options/logoregion-br.xml</include>
	<include subset="banner" name="on" displayName="Banner: on (1-2 rows)">./_inc/options/banner-on.xml</include>
	<include subset="banner" name="off" displayName="Banner: off">./_inc/options/banner-off.xml</include>
	<include>./_inc/options/tiles.xml</include>
	<include>./_inc/layout/common.xml</include>
	<include subset="systemview" name="Grid 2 rows" displayName="System view: grid, 2 rows">./_inc/layout/system-grid-rows-2.xml</include>
	<include subset="systemview" name="Grid 1 row" displayName="System view: grid, 1 row">./_inc/layout/system-grid-rows-1.xml</include>
	<include subset="systemview" name="Grid 3 rows" displayName="System view: grid, 3 rows">./_inc/layout/system-grid-rows-3.xml</include>
	<include subset="systemview" name="Grid 4 rows" displayName="System view: grid, 4 rows">./_inc/layout/system-grid-rows-4.xml</include>
	<include subset="systemview" name="Grid 5 rows" displayName="System view: grid, 5 rows">./_inc/layout/system-grid-rows-5.xml</include>
	<include subset="systemview" name="Carousel" displayName="System view: carousel (1 row, no banner)">./_inc/layout/system-carousel.xml</include>
	<include subset="gamerows" name="2 rows" displayName="Game list: 2 rows">./_inc/layout/gamelist-rows-2.xml</include>
	<include subset="gamerows" name="1 row" displayName="Game list: 1 row">./_inc/layout/gamelist-rows-1.xml</include>
	<include subset="gamerows" name="3 rows" displayName="Game list: 3 rows">./_inc/layout/gamelist-rows-3.xml</include>
	<include subset="gamerows" name="4 rows" displayName="Game list: 4 rows">./_inc/layout/gamelist-rows-4.xml</include>
	<include subset="gamerows" name="5 rows" displayName="Game list: 5 rows">./_inc/layout/gamelist-rows-5.xml</include>
</theme>
